{
    "layer": "top",
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-left": 0,
    "margin-right": 0,
    "spacing": 0,

    "modules-left": [
        "custom/appmenu",
        "ext/workspaces",
        "group/quicklinks"
    ],

    "modules-center": [
        "hyprland/window"
    ],

    "modules-right": [
        "mpd",
        "group/audio",
        "network",
        "cpu",
        "memory",
        "keyboard-state",
        "hyprland/language",
        "battery",
        "tray",
        "clock",
        "custom/exit"
    ],

    "custom/quicklink1": {
        "format": " ",
        "on-click": "systemsettings",
        "tooltip-format": "Open Hyprland Settings"
    },

    "custom/quicklink2": {
        "format": " ",
        "on-click": "google-chrome-stable",
        "tooltip-format": "Open the browser"
    },

    "custom/quicklink3": {
        "format": " ",
        "on-click": "thunar",
        "tooltip-format": "Open the filemanager"
    },

    "custom/quicklinkempty": {},

    "group/quicklinks": {
        "orientation": "horizontal",
        "modules": [
            "custom/quicklink1",
            "custom/quicklink2",
            "custom/quicklink3",
            "custom/quicklinkempty"
        ]
    },

    "ext/workspaces": {
        "on-click": "activate",
        "active-only": false,
        "all-outputs": true,
        "format": "{id}",
        "format-icons": {
            "active": "",
            "default": ""
        },
        "sort-by-id": true,
        "ignore-hidden": false
    },

    "hyprland/window": {
        "rewrite": {
            "(.*) - Brave": "$1",
            "(.*) - Chromium": "$1",
            "(.*) - Brave Search": "$1",
            "(.*) - Outlook": "$1",
            "(.*) Microsoft Teams": "$1"
        },
        "separate-outputs": true
    },

    "custom/appmenu": {
        "format": "Apps",
        "tooltip-format": "Left: Open the application launcher\nRight: Show all keybindings",
        "on-click": "rofi -show drun -replace",
        "on-click-right": "~/.config/hypr/scripts/keybindings.sh",
        "tooltip": false
    },

    "custom/exit": {
        "format": "",
        "tooltip-format": "Powermenu",
        "on-click": "wlogout -b 4",
        "tooltip": false
    },

    "keyboard-state": {
        "numlock": true,
        "capslock": true,
        "format": "{name} {icon}",
        "format-icons": {
            "locked": "",
            "unlocked": ""
        }
    },

    "tray": {
        // "icon-size": 21,
        "spacing": 10
    },

    "clock": {
        "timezone": "Europe/Minsk",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}",
        "calendar": {
            "format": {
                "today": "<span color='#ebcb8b'><b><u>{}</u></b></span>"
            }
        }
    },

    "custom/system": {
        "format": "",
        "tooltip": false
    },

    "cpu": {
        "format": "C {usage}% ",
        "on-click": "kitty -e btop"
    },

    "memory": {
        "format": "M {}% ",
        "on-click": "kitty -e btop"
    },

    "disk": {
        "interval": 30,
        "format": "D {percentage_used}% ",
        "path": "/",
        "on-click": "kitty -e btop"
    },

    "hyprland/language": {
        "format": "{short}"
    },

    "group/hardware": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 300,
            "children-class": "not-memory",
            "transition-left-to-right": false
        },
        "modules": [
            "custom/system",
            "disk",
            "cpu",
            "memory",
            "hyprland/language"
        ]
    },

    "network": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{ifname}",
        "format-wifi": "    {signalStrength}%",
        "format-ethernet": "  {ifname}",
        "format-disconnected": "Disconnected ⚠",
        "tooltip-format": " {ifname} via {gwaddri}",
        "tooltip-format-wifi": "  {ifname} @ {essid}\nIP: {ipaddr}\nStrength: {signalStrength}%\nFreq: {frequency}MHz\nUp: {bandwidthUpBits} Down: {bandwidthDownBits}",
        "tooltip-format-ethernet": " {ifname}\nIP: {ipaddr}\n up: {bandwidthUpBits} down: {bandwidthDownBits}",
        "tooltip-format-disconnected": "Disconnected",
        "max-length": 64,
        "on-click": "kitty -e nmtui",
    },

    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "interval": 60,
        "format": "{capacity}% {icon}",
        "format-icons": {
            "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
            "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
        },
        // "format": "{icon}{capacity}%",
        "format-charging": "\udb80\udc85  {capacity}%",
        "format-plugged": "  {capacity}%",
        "format-alt": "{icon}  {time}",
        // "format-good": "", // An empty format will hide the module
        // "format-full": ""
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": "\udb81\udf5f {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "default": [
                "",
                " ",
                " "
            ]
        },
        "on-click": "pavucontrol"
    },

    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal",
        "zero-on-mute": false,
        "unmute-on-volume-change": false
    },

    "group/audio": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 200,
            "children-class": "audio-slider"
        },
        "modules": [
            "pulseaudio",
            "pulseaudio/slider"
        ]
    },

    "bluetooth": {
        "format-disabled": "",
        "format-off": "",
        "format-connected": " {num_connections}",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "interval": 30,
        "on-click": "blueman-manager",
        "format-no-controller": ""
    },

    "user": {
        "format": "{user}",
        "interval": 60,
        "icon": false
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "tooltip": true,
        "format-icons": {
            "activated": "",
            "deactivated": ""
        },
        "on-click-right": "hyprlock"
    }
}
